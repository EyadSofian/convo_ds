{
  "name": "convo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --noEmit --pretty false && tsc -p apps/web/tsconfig.tests.json --noEmit --pretty false && tsc -p tsconfig.e2e.json --noEmit --pretty false",
    "build": "tsc -b --pretty false && pnpm --filter @convo/web build",
    "db:bootstrap": "tsx packages/database/src/bin.ts bootstrap",
    "db:migrate": "tsx packages/database/src/bin.ts migrate",
    "start:api": "node apps/api/dist/main.js",
    "start:web": "pnpm --filter @convo/web dev",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --project property",
    "test:contracts": "echo 'not_run: no adapters yet (P2)' && exit 1",
    "test:e2e": "playwright test --project=desktop-1440 --project=desktop-1366",
    "test:a11y": "playwright test --project=desktop-1366 tests/e2e/a11y.spec.ts",
    "test:security": "echo 'not_run: scanners wired in P1-T4' && exit 1",
    "test:mutation": "echo 'not_run: wired in P4' && exit 1",
    "test:load:target": "echo 'blocked_env: k6 not installed, no staging target' && exit 1",
    "test:recovery": "echo 'blocked_env: no restore target' && exit 1",
    "test:visual": "playwright test --project=desktop-1366 tests/e2e/visual.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@nestjs/platform-fastify": "11.1.6",
    "@playwright/test": "1.55.0",
    "@types/node": "22.7.5",
    "@types/pg": "8.11.10",
    "@vitest/coverage-v8": "2.1.2",
    "argon2": "0.44.0",
    "axe-core": "4.10.2",
    "embedded-postgres": "17.4.0-beta.15",
    "eslint": "9.12.0",
    "fastify": "5.4.0",
    "happy-dom": "15.7.4",
    "pg": "8.13.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.8.1",
    "vite": "6.1.0",
    "vitest": "2.1.2"
  }
}
