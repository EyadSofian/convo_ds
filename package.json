{
  "name": "convo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --noEmit --pretty false",
    "build": "tsc -b --pretty false",
    "db:migrate": "tsx packages/database/src/cli.ts migrate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --project property",
    "test:contracts": "echo 'not_run: no adapters yet (P2)' && exit 1",
    "test:e2e": "echo 'not_run: no app yet (P2)' && exit 1",
    "test:a11y": "echo 'not_run: no UI yet (P1/P2)' && exit 1",
    "test:security": "echo 'not_run: scanners wired in P1-T4' && exit 1",
    "test:mutation": "echo 'not_run: wired in P4' && exit 1",
    "test:load:target": "echo 'blocked_env: k6 not installed, no staging target' && exit 1",
    "test:recovery": "echo 'blocked_env: no restore target' && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@types/node": "22.7.5",
    "@types/pg": "8.11.10",
    "@vitest/coverage-v8": "2.1.2",
    "embedded-postgres": "17.4.0-beta.15",
    "eslint": "9.12.0",
    "pg": "8.13.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.8.1",
    "vitest": "2.1.2"
  }
}
