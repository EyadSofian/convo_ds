{
  "openapi": "3.1.0",
  "info": {
    "title": "DS Omnichannel WhatsApp CRM API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://omnichannel.berlitzdigitalschool-eg.com/api/v1/tenants/{tenantId}/crm/whatsapp",
      "variables": {
        "tenantId": {
          "default": "00000000-0000-4000-8000-000000000000",
          "description": "Workspace ID from Omni Settings"
        }
      }
    }
  ],
  "paths": {
    "/senders": {
      "get": {
        "operationId": "listCrmWhatsAppSenders",
        "summary": "List allowed connected WhatsApp senders",
        "security": [
          {
            "CrmBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CrmWhatsAppSender"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/senders/{connectionId}/templates": {
      "get": {
        "operationId": "listCrmWhatsAppTemplates",
        "summary": "List synchronized templates for a sender",
        "security": [
          {
            "CrmBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "name": "connectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Pass nextCursor from the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CrmWhatsAppTemplates"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/lookup": {
      "post": {
        "operationId": "lookupCrmWhatsAppContact",
        "summary": "Find a contact and its current conversations",
        "security": [
          {
            "CrmBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrmWhatsAppLookupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CrmWhatsAppLookup"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "operationId": "sendCrmWhatsAppTemplate",
        "summary": "Queue an approved WhatsApp template",
        "security": [
          {
            "CrmBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrmWhatsAppSendRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Template message durably queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CrmWhatsAppMessage"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/messages/{messageId}": {
      "get": {
        "operationId": "getCrmWhatsAppMessage",
        "summary": "Read dispatch, receipt and conversation status",
        "security": [
          {
            "CrmBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CrmWhatsAppMessage"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CrmBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Omni CRM key"
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "A safe typed failure. HTTP status carries failure semantics.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "invalid_input",
                "message": "The installation bootstrap request is not valid.",
                "request_id": "request-123",
                "details": [
                  {
                    "field": "ownerEmail",
                    "code": "malformed",
                    "message": "A valid owner email is required."
                  }
                ]
              }
            }
          }
        }
      },
      "RateLimit": {
        "description": "A safe typed failure. HTTP status carries failure semantics.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "invalid_input",
                "message": "The installation bootstrap request is not valid.",
                "request_id": "request-123",
                "details": [
                  {
                    "field": "ownerEmail",
                    "code": "malformed",
                    "message": "A valid owner email is required."
                  }
                ]
              }
            }
          }
        }
      }
    },
    "schemas": {
      "CrmWhatsAppSender": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "phoneNumberId": {
            "type": "string"
          },
          "displayPhoneNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sendReady": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "displayName",
          "phoneNumberId",
          "displayPhoneNumber",
          "sendReady"
        ]
      },
      "CrmWhatsAppLookupRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+?[1-9][0-9]{7,14}$",
            "examples": [
              "+12025550123"
            ]
          },
          "contactId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "phone"
            ]
          },
          {
            "required": [
              "contactId"
            ]
          }
        ]
      },
      "CrmWhatsAppLookup": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+?[1-9][0-9]{7,14}$",
            "examples": [
              "+12025550123"
            ]
          },
          "contactId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "conversations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "connectionId",
                "status"
              ]
            }
          }
        },
        "required": [
          "phone",
          "contactId",
          "conversations"
        ]
      },
      "CrmWhatsAppSendRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+?[1-9][0-9]{7,14}$",
            "examples": [
              "+12025550123"
            ]
          },
          "contactId": {
            "type": "string",
            "format": "uuid"
          },
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190
          },
          "template": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            },
            "required": [
              "id",
              "parameters"
            ]
          },
          "clientMessageId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{8,190}$"
          },
          "optInReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "connectionId",
          "template",
          "clientMessageId",
          "optInReference"
        ],
        "anyOf": [
          {
            "required": [
              "phone"
            ]
          },
          {
            "required": [
              "contactId"
            ]
          }
        ]
      },
      "CrmWhatsAppMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientMessageId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "contactId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationStatus": {
            "type": "string"
          },
          "commandState": {
            "type": "string"
          },
          "stateReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "deliveryState": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sent",
                  "delivered",
                  "read"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "deliveryAnomaly": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "providerMessageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "settledAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastCustomerMessageAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "clientMessageId",
          "connectionId",
          "contactId",
          "conversationId",
          "conversationStatus",
          "commandState",
          "stateReason",
          "deliveryState",
          "deliveryAnomaly",
          "providerMessageId",
          "queuedAt",
          "settledAt",
          "lastCustomerMessageAt"
        ]
      },
      "CrmWhatsAppTemplates": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "connectionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "components": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "key"
                    ]
                  }
                },
                "sendSupported": {
                  "type": "boolean"
                },
                "unsupportedReason": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastSyncedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "connectionId",
                "name",
                "language",
                "category",
                "status",
                "components",
                "parameters",
                "sendSupported",
                "unsupportedReason",
                "lastSyncedAt"
              ]
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnvelope"
          }
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "The accepted or server-generated request identifier.",
        "schema": {
          "type": "string"
        }
      }
    }
  }
}
