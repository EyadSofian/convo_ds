{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": true
  },
  "mutate": [
    "apps/api/src/client-address.ts:42-60",
    "apps/api/src/channels/meta-whatsapp.transport.ts:272-319",
    "apps/api/src/channels/meta-whatsapp.transport.ts:345-395",
    "packages/domain/src/automations/schedule.ts:7-32",
    "packages/domain/src/automations/workflow.ts:36-57",
    "packages/domain/src/email/messages.ts:51-61"
  ],
  "reporters": ["clear-text", "progress", "json", "html"],
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "OptionalChaining"]
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "concurrency": 4,
  "cleanTempDir": true
}
