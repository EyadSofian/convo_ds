# Installation. Choose exactly one mode: saas or self_hosted_single.
CONVO_DEPLOYMENT_MODE=self_hosted_single
CONVO_INSTALLATION_NAME="DS Omnichannel"
# Every link in every email is built from this. Never a request Host, never a
# literal in the code. Set it to the public origin the browser actually uses.
CONVO_PUBLIC_BASE_URL=http://127.0.0.1:3000
CONVO_DEFAULT_LOCALE=ar
# Language of invitation and recovery emails: en (default) or ar.
CONVO_EMAIL_LOCALE=en
CONVO_SUPPORTED_LOCALES=ar,en
CONVO_MFA_ENABLED=true

# API process.
# One of: api, ingress, realtime, worker-inbound, worker-interactive,
# worker-campaign, worker-integration, worker-automation, worker-report.
CONVO_PROCESS_ROLE=api
CONVO_API_HOST=127.0.0.1
CONVO_API_PORT=3000

# How many reverse proxies sit in front of this process.
#
# Zero means "ignore X-Forwarded-For entirely; the socket is the client". That is
# the safe default and it is WRONG for any deployment where the browser reaches
# the API through the web service — there, every user shares one rate-limit
# bucket, so five failed logins from anybody lock out the whole installation.
#
# On Railway the correct value is 2: the Railway edge, then our own web proxy.
# Setting it too high is the opposite failure — a client could then choose its
# own bucket by sending a header and never be rate limited at all.
CONVO_TRUSTED_PROXY_HOPS=0

# Generate these independently, for example: openssl rand -hex 32
CONVO_AUTH_HASH_SECRET=
CONVO_BOOTSTRAP_TOKEN=
CONVO_IDEMPOTENCY_HASH_SECRET=

# Service email. REQUIRED IN PRODUCTION.
#
# A process with NODE_ENV=production refuses to start when the provider is
# missing or set to `logging`, because an installation that cannot send an
# invitation cannot onboard anybody — and silently logging instead of sending is
# how that goes unnoticed until a new employee says the link never arrived.
#
# `logging` is permitted outside production only. It sends nothing.
# The sender domain must be verified with the provider before anything sends.
CONVO_EMAIL_PROVIDER=logging
# CONVO_EMAIL_PROVIDER=resend
# CONVO_EMAIL_PROVIDER=smtp
# CONVO_EMAIL_FROM="Digital School <operations@example.com>"
# CONVO_RESEND_API_KEY=
# SMTP credentials belong only on worker-integration. Port 465 uses implicit
# TLS, so CONVO_SMTP_SECURE must be true; it is not STARTTLS.
# CONVO_SMTP_HOST=smtp.hostinger.com
# CONVO_SMTP_PORT=465
# CONVO_SMTP_SECURE=true
# CONVO_SMTP_USERNAME=no-reply@example.com
# CONVO_SMTP_PASSWORD=

# Outbound channel transport. `none` refuses every send with a typed reason and
# is the honest default until authorized provider assets exist. `meta` selects
# the Meta Graph adapter for WhatsApp Cloud API, Facebook Messenger and
# Instagram Messaging. Each provider access token is per-connection and sealed
# in the database, never configured here.
CONVO_CHANNEL_TRANSPORT=none

# Structured logging. info, or debug when chasing something specific.
CONVO_LOG_LEVEL=info

# Durable broker for the integration relay. Optional.
#
# When unset the relay skips and its outbox grows visibly; `worker-integration`
# still runs, because email delivery lives there too (ADR-0018). When it IS set,
# `worker-integration` fails closed if the broker is unreachable, rather than
# reporting healthy while events pile up unsent.
# CONVO_BROKER_URL=

# Worker round size. Ignored by the HTTP roles.
CONVO_WORKER_CONCURRENCY=4

# PostgreSQL cluster and roles. Replace every password before use.
CONVO_PG_HOST=127.0.0.1
CONVO_PG_PORT=5432
CONVO_PG_SUPERUSER=postgres
CONVO_PG_SUPERPASSWORD=
CONVO_PG_DATABASE=convo
CONVO_PG_MIGRATION_ROLE=convo_migration
CONVO_PG_MIGRATION_PASSWORD=
CONVO_PG_RUNTIME_ROLE=convo_app
CONVO_PG_RUNTIME_PASSWORD=

# Provider assets are client-owned server secrets. Keep them in the target
# platform's secret manager or injected process environment. The suffix must
# match the app-secret reference stored for the channel app; never expose them
# to web, bake them into an image, or include them in a source archive.
#
# The two below are read by
#   pnpm db:register-channel-app --external-app-id <Meta App ID> --secret-ref META_APP
# which creates the installation's `channel_apps` row and prints the webhook
# path. `CONVO_CHANNEL_SECRET_<REF>` is then read by the API and the dispatching
# workers at runtime to verify every Meta webhook signature; the verify token is
# needed only at registration, and is the value you enter in Meta's webhook
# configuration. Until that row exists, connecting a Meta channel is refused
# with `channel_app_not_configured`.
# CONVO_CHANNEL_SECRET_META_APP=
# CONVO_CHANNEL_VERIFY_TOKEN_META_APP=

# Encrypts channel credentials and Web Push subscriptions (AES-256-GCM).
#
# Required before any channel can be connected AND before a browser can register
# for device notifications; both seal their secret with this key. Generate with
#   echo "v1:$(openssl rand -base64 32)"
# Keep old versions in the comma-separated list when rotating, or everything
# sealed under them becomes unreadable.
# CONVO_CREDENTIAL_KEYS=v1:<base64-32-byte-key>

# Browser push notifications (VAPID). All three, or none.
#
# Without them the product is quietly push-less: `push-config` returns a null
# key, the notification drawer offers nothing but "unavailable", device
# registration answers 503 `push_unconfigured`, and `worker-integration` drains
# zero of its push queue without logging a reason. In-app notifications and the
# unread badge still work; only the device/lock-screen alert is absent.
#
# Generate one pair for the whole installation:
#   npx web-push generate-vapid-keys
#
# The public key goes to the API (the browser subscribes with it). All three go
# to `worker-integration`, which is the only role that sends. The subject must
# be a mailto: or https: URL a push service can contact you at.
# CONVO_WEB_PUSH_PUBLIC_KEY=
# CONVO_WEB_PUSH_PRIVATE_KEY=
# CONVO_WEB_PUSH_SUBJECT=mailto:ops@example.com
